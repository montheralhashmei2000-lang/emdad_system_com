rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAuth() { return request.auth != null; }
    function isAdmin() {
      return isAuth() && 
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    function hasPerm(module, action) {
      let perms = get(/databases/$(database)/documents/users/$(request.auth.uid)).data.permissions;
      return perms != null && perms[module] != null && perms[module][action] == true;
    }
    function isOwner(uid) { return isAuth() && request.auth.uid == uid; }
    
    // === ITEMS (المخزون) ===
    match /items/{itemId} {
      allow read: if isAuth();
      allow create: if isAdmin() || hasPerm('items', 'create');
      allow update: if isAdmin() || hasPerm('items', 'update');
      allow delete: if isAdmin();
    }
    
    // === CATEGORIES ===
    match /categories/{catId} {
      allow read: if isAuth();
      allow write: if isAdmin();
    }
    
    // === UNITS ===
    match /units/{unitId} {
      allow read: if isAuth();
      allow write: if isAdmin();
    }
    
    // === SUPPLIERS ===
    match /suppliers/{supId} {
      allow read: if isAuth();
      allow create: if hasPerm('suppliers', 'create');
      allow update, delete: if isAdmin();
    }
    
    // === RECEIPTS (الواردات) ===
    match /receipts/{recId} {
      allow read: if isAuth();
      allow create: if hasPerm('receipt', 'create');
      allow update: if isAdmin() || hasPerm('receipt', 'approve');
      allow delete: if isAdmin();
    }
    
    // === ISSUES (الصرف) ===
    match /issues/{issueId} {
      allow read: if isAuth();
      // إنشاء: status = DRAFT أو ORDER فقط
      allow create: if hasPerm('issue', 'create') && 
                      request.resource.data.status in ['DRAFT', 'ORDER'];
      // تعديل: المدير أو منشئ المستند في حالة DRAFT
      allow update: if isAdmin() ||
                      (resource.data.status == 'DRAFT' && resource.data.createdBy == request.auth.token.email &&
                       request.resource.data.createdBy == resource.data.createdBy &&
                       request.resource.data.status in ['DRAFT', 'ORDER']);
      allow delete: if isAdmin();
    }

    // === TRANSFERS (التحويلات) ===
    match /transfers/{tfId} {
      allow read: if isAuth();
      allow create: if hasPerm('transfer', 'create') && 
                      request.resource.data.status in ['DRAFT', 'ORDER'];
      allow update: if isAdmin() ||
                      (resource.data.status == 'DRAFT' && resource.data.createdBy == request.auth.token.email &&
                       request.resource.data.createdBy == resource.data.createdBy &&
                       request.resource.data.status in ['DRAFT', 'ORDER']);
      allow delete: if isAdmin();
    }

    // === RETURNS (المرتجعات) ===
    match /returns/{retId} {
      allow read: if isAuth();
      allow create: if hasPerm('return', 'create');
      allow update: if isAdmin() || hasPerm('return', 'approve');
      allow delete: if isAdmin();
    }
    
    // === USERS ===
    match /users/{uid} {
      allow read: if isAdmin() || isOwner(uid);
      // المستخدم يقدر يعدل بياناته فقط (ما عدا role و approved)
      allow update: if isAdmin() ||
                      (isOwner(uid) && !request.resource.data.diff(resource.data).affectedKeys()
                         .hasAny(['role', 'permissions', 'approved', 'status']));
      allow create: if isAdmin();
      // لا allow delete - يحذفه المدير يدوياً من Console
    }
    
    // === AUDIT LOGS ===
    match /auditLogs/{logId} {
      allow read: if isAdmin() || hasPerm('auditTrail', 'view');
      // ممنوع الكتابة من العميل - فقط Cloud Functions
      allow write: if false;
    }
    
    // === ERROR LOGS ===
    match /errorLogs/{logId} {
      allow read: if isAdmin();
      allow write: if false; // ممنوع - للتشخيص فقط
    }
    
    // === ENTITLEMENTS ===
    match /entitlements/{entId} {
      allow read: if isAuth();
      allow write: if isAdmin();
    }
    
    // === OPERATION COMMANDS ===
    match /operationCommands/{cmdId} {
      allow read: if isAuth();
      allow create: if hasPerm('commands', 'create');
      allow update: if isAdmin();
      allow delete: if false;
    }
    
    // === NOTIFICATIONS ===
    match /notifications/{notifId} {
      allow read: if isOwner(resource.data.userId);
      allow update: if isOwner(resource.data.userId) &&
                      request.resource.data.userId == resource.data.userId;
      allow delete: if isOwner(resource.data.userId);
      allow create: if false;
    }
    
    // === RULES ===
    match /rules/{ruleId} {
      allow read: if isAuth();
      allow write: if isAdmin();
    }
  }
}