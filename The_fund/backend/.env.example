# .env.example
# انسخه إلى .env واملأ القيم الحقيقية قبل تشغيل الخادم.

DATABASE_URL=postgresql://fund_user:fund_pass@localhost:5432/social_fund_db

# توليد: python -c "import secrets; print(secrets.token_urlsafe(48))"
# إلزامي في الإنتاج - الخادم يرفض الإقلاع بقيمة CHANGE_ME
SECRET_KEY=

# توليد: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# إلزامي في الإنتاج - فقدانه يعني فقدان القدرة على فك البيانات المشفرة
FIELD_ENCRYPTION_KEY=

ENV=production

# نطاقات الواجهة مفصولة بفواصل - لا تستخدم * في الإنتاج
CORS_ORIGINS=https://app.example.com

# --- حساب المدير الأول (python seed.py) ---
INITIAL_ADMIN_PASSWORD=
SEED_ADMIN_USERNAME=admin
# في الإنتاج أضف SEED_CONFIRM=yes للتأكيد

# --- إشعارات Firebase (Firebase Admin SDK) ---
# ملف بيانات الاعتماد يجب أن يبقى خارج مجلد المشروع وGit وZIP
FIREBASE_CREDENTIALS_PATH=/secure/path/firebase-service-account.json

# --- رسائل SMS OTP (Twilio) ---
# اتركها فارغة في التطوير فقط (يُطبع الرمز في الطرفية في وضع التطوير حصراً)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
